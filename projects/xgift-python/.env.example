# Copy to private/server.env (UTF-8); no shell expansion/inline comments.
XGIFT_MODE=simulated
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=gift.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://gift.example.com
DJANGO_HTTPS=true
XGIFT_TRUST_CADDY=true
XGIFT_DATABASE="C:/XGift data/db.sqlite3"
XGIFT_KEY_FILE="C:/XGift data/master.key"
# Set a long independent random secret locally; do not commit it.
# DJANGO_SECRET_KEY=...
